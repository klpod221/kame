# Port web app & API lắng nghe
PORT=8080

# Đường dẫn lưu trữ SQLite Database (Volume)
DB_PATH=/data/catalog.db

# Google OAuth2 Client ID (Web Application)
# Yêu cầu cấu hình Authorized JavaScript Origins: http://localhost:8080 (hoặc domain của bạn)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Danh sách Gmail được phép truy cập hệ thống (cách nhau bởi dấu phẩy)
# Nếu để trống, mọi tài khoản Google đều được phép truy cập
WHITELIST_EMAILS=user1@gmail.com,user2@gmail.com,admin@gmail.com

# Danh sách Gmail có quyền Admin (thêm game, cào metadata, xóa game)
# Nếu để trống, tất cả user trong WHITELIST_EMAILS đều có quyền Admin
ADMIN_EMAILS=admin@gmail.com

# Khóa bí mật ký JWT Session (tùy chọn, nếu để trống server sẽ tự tạo random key lúc khởi động)
JWT_SECRET=super-secret-random-32-chars-string

# RAWG API Key (Lấy miễn phí tại https://rawg.io/apidocs)
RAWG_API_KEY=your-rawg-api-key

# IGDB / Twitch API Credentials (Tùy chọn - dùng làm fallback cho RAWG)
# Tạo app tại https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
