# Web application and API listening port
PORT=8324

# SQLite Database storage path (Mounted volume)
DB_PATH=/data/catalog.db

# Google OAuth2 Client ID (Web Application)
# Note: Add Authorized JavaScript Origins: http://localhost:8324 (or your production domain)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Comma-separated list of whitelisted Gmail addresses allowed to access the system
# If left empty, any authenticated Google account is allowed
WHITELIST_EMAILS=user1@gmail.com,user2@gmail.com,admin@gmail.com

# Comma-separated list of Gmail addresses with Administrator role (add/delete games, scrape metadata)
# If left empty, all users in WHITELIST_EMAILS will have Admin privileges
ADMIN_EMAILS=admin@gmail.com

# Secret key used for signing JWT session tokens (optional: auto-generated at startup if empty)
JWT_SECRET=super-secret-random-32-chars-string

# RAWG API Key (Get free key at https://rawg.io/apidocs)
RAWG_API_KEY=your-rawg-api-key

# IGDB / Twitch API Credentials (Optional: used as fallback for RAWG)
# Register application at https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
